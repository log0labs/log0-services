# Compose-level secrets for docker/. Copy to .env (gitignored) and fill in.
# Service secrets (GROQ/JWT/SLACK) stay in each services/<svc>/.env - not here.

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> create -> copy token).
# Only needed when running with docker-compose.tunnel.yml.
CF_TUNNEL_TOKEN=

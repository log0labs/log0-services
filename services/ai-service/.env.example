# JWT_SECRET env should be same in both auth-service and ai-service, otherwise JWT validation will fail.
JWT_SECRET=
# Same value in services/incident-service/.env (AiSummarizer sends X-Internal-Token on POST /summaries).
INTERNAL_SERVICE_TOKEN=

# ---- Per-purpose models (provider:model) : swap freely for testing ----
# Groq ids change over time - run: uv run python scripts/list_groq_models.py
LLM_SUMMARY=groq:openai/gpt-oss-20b
LLM_TRIAGE=groq:openai/gpt-oss-20b
LLM_INVESTIGATION=groq:qwen/qwen3.8-27b
LLM_EVALUATION=groq:openai/gpt-oss-120b
# Examples:
# LLM_SUMMARY=openrouter:meta-llama/llama-3.3-70b-instruct:free
# LLM_INVESTIGATION=huggingface:Qwen/Qwen2.5-72B-Instruct

# ---- Platform API keys (set keys for every provider you reference above) ----
GROQ_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

DATABASE_URL=
INCIDENT_SERVICE_URL=http://localhost:8083

# ---- LangSmith (step 0.15 enables export to os.environ) ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=log0-ai-service

# JWT_SECRET env should be same in both auth-service and ai-service, otherwise JWT validation will fail.
JWT_SECRET=
# Same value in services/incident-service/.env (AiSummarizer sends X-Internal-Token on POST /summaries).
INTERNAL_SERVICE_TOKEN=

# ---- Per-purpose models (provider:model) : swap freely for testing ----
# Groq ids change over time - run: uv run python scripts/list_groq_models.py
LLM_SUMMARY=groq:openai/gpt-oss-20b
LLM_TRIAGE=groq:openai/gpt-oss-20b
LLM_INVESTIGATION=groq:openai/gpt-oss-120b
LLM_EVALUATION=groq:openai/gpt-oss-120b
# Examples:
# LLM_SUMMARY=openrouter:meta-llama/llama-3.3-70b-instruct:free
# LLM_INVESTIGATION=huggingface:Qwen/Qwen2.5-72B-Instruct

# How each purpose asks for structured output; depends on the model (see config.py)
# gpt-oss models: json_schema. qwen on Groq: function_calling (it rejects json_schema).
LLM_TRIAGE_OUTPUT_METHOD=json_schema
LLM_INVESTIGATION_OUTPUT_METHOD=json_schema

# Usage pricing config:
LLM_PRICES={"openai/gpt-oss-120b": [0.15, 0.60], "openai/gpt-oss-20b": [0.075, 0.30]}

# ---- Platform API keys (set keys for every provider you reference above) ----
GROQ_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

DATABASE_URL=

# ---- Master keys for tenant secrets (3.2): make one with `uv run python scripts/new_secret_key.py` ----
# SECRETS_KEYS={"k1": "<the printed key>"}
# SECRETS_ACTIVE_KEY_ID=k1

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=ai_reader
CLICKHOUSE_PASSWORD=ai_reader_dev

INCIDENT_SERVICE_URL=http://localhost:8083
INCIDENT_DB_PASSWORD=

# ---- LangSmith (step 0.15 enables export to os.environ) ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=log0-ai-service
